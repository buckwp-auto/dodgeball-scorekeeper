rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function appAdminPath(uid) {
      return /databases/$(database)/documents/appAdmins/$(uid);
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(appAdminPath(request.auth.uid))
        && get(appAdminPath(request.auth.uid)).data.role == 'superAdmin';
    }

    function isAppAdmin() {
      return signedIn()
        && exists(appAdminPath(request.auth.uid))
        && get(appAdminPath(request.auth.uid)).data.role in ['superAdmin', 'appAdmin'];
    }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)).data;
    }

    function leagueDocAfter(leagueId) {
      return getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data;
    }

    function memberPath(leagueId, uid) {
      return /databases/$(database)/documents/leagues/$(leagueId)/members/$(uid);
    }

    function leagueMemberAdmin(leagueId) {
      return exists(memberPath(leagueId, request.auth.uid))
        && get(memberPath(leagueId, request.auth.uid)).data.status == 'active'
        && get(memberPath(leagueId, request.auth.uid)).data.role == 'admin';
    }

    function leagueAdmin(leagueId) {
      return signedIn()
        && (
          leagueDoc(leagueId).adminUid == request.auth.uid
          || leagueMemberAdmin(leagueId)
          || isAppAdmin()
        );
    }

    function activeMember(leagueId) {
      return signedIn()
        && exists(memberPath(leagueId, request.auth.uid))
        && get(memberPath(leagueId, request.auth.uid)).data.status == 'active';
    }

    function canAccessLeagueData(leagueId) {
      return activeMember(leagueId) || isAppAdmin();
    }

    function stringLen(value, max) {
      return value is string && value.size() <= max;
    }

    function imageRefOrNull(value) {
      return value == null
        || (
          value is map
          && value.keys().hasOnly(['kind', 'url', 'storagePath', 'contentType', 'updatedAt'])
          && value.keys().hasAll(['kind', 'url'])
          && value.kind in ['external', 'storage']
          && stringLen(value.url, 2048)
          && value.url.matches('^https://.+')
          && (!('storagePath' in value) || stringLen(value.storagePath, 512))
          && (!('contentType' in value) || stringLen(value.contentType, 100))
          && (!('updatedAt' in value) || stringLen(value.updatedAt, 40))
        );
    }

    match /rateLimits/{uid}/hours/{bucket} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == 1
        && stringLen(request.resource.data.updatedAt, 40);
      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && resource.data.count is int
        && resource.data.count < 100
        && request.resource.data.count == resource.data.count + 1
        && stringLen(request.resource.data.updatedAt, 40);
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAppAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'lastSeenAt'])
        && stringLen(request.resource.data.email, 254)
        && stringLen(request.resource.data.displayName, 80)
        && stringLen(request.resource.data.lastSeenAt, 40);
      allow delete: if false;
    }

    match /appAdmins/{uid} {
      allow read: if isSelf(uid) || isAppAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.role == 'appAdmin'
        && request.resource.data.keys().hasOnly([
          'role', 'email', 'displayName', 'grantedAt', 'grantedBy'
        ])
        && stringLen(request.resource.data.email, 254)
        && stringLen(request.resource.data.displayName, 80)
        && stringLen(request.resource.data.grantedAt, 40)
        && stringLen(request.resource.data.grantedBy, 128)
        && request.resource.data.grantedBy == request.auth.uid;
      allow update: if isSuperAdmin()
        && resource.data.role == 'appAdmin'
        && request.resource.data.role == 'appAdmin'
        && request.resource.data.keys().hasOnly([
          'role', 'email', 'displayName', 'grantedAt', 'grantedBy'
        ])
        && stringLen(request.resource.data.email, 254)
        && stringLen(request.resource.data.displayName, 80)
        && stringLen(request.resource.data.grantedAt, 40)
        && stringLen(request.resource.data.grantedBy, 128);
      allow delete: if isSuperAdmin()
        && resource.data.role == 'appAdmin';
    }

    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'createdAt', 'adminUid', 'adminDisplayName', 'adminEmail'
        ])
        && request.resource.data.adminUid == request.auth.uid
        && stringLen(request.resource.data.name, 80)
        && stringLen(request.resource.data.adminDisplayName, 80)
        && stringLen(request.resource.data.adminEmail, 254)
        && stringLen(request.resource.data.createdAt, 40);
      allow update: if (
        leagueAdmin(leagueId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logo', 'banner'])
        && (!('logo' in request.resource.data) || imageRefOrNull(request.resource.data.logo))
        && (!('banner' in request.resource.data) || imageRefOrNull(request.resource.data.banner))
      ) || (
        isAppAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'adminUid', 'adminDisplayName', 'adminEmail'
        ])
        && stringLen(request.resource.data.adminUid, 128)
        && request.resource.data.adminUid.size() > 0
        && stringLen(request.resource.data.adminDisplayName, 80)
        && stringLen(request.resource.data.adminEmail, 254)
      );
      allow delete: if false;

      match /members/{uid} {
        allow read: if isSelf(uid) || leagueAdmin(leagueId);

        // Join request, or admin bootstrap in the same batch as league create.
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasAll([
            'email', 'displayName', 'role', 'status', 'requestedAt', 'joinedAt'
          ])
          && stringLen(request.resource.data.email, 254)
          && stringLen(request.resource.data.displayName, 80)
          && (
            (
              request.resource.data.role == 'member'
              && request.resource.data.status == 'pending'
              && request.resource.data.joinedAt == null
            )
            || (
              request.resource.data.role == 'admin'
              && request.resource.data.status == 'active'
              && request.resource.data.joinedAt is string
              && leagueDocAfter(leagueId).adminUid == request.auth.uid
            )
          );

        allow update: if leagueAdmin(leagueId)
          && request.resource.data.email == resource.data.email
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.role in ['admin', 'member']
          && request.resource.data.status in ['active', 'rejected', 'pending'];

        allow delete: if leagueAdmin(leagueId);
      }

      match /roster/{docId} {
        allow read: if canAccessLeagueData(leagueId);
        // Allow create during league bootstrap (creator is admin after batch).
        allow create, update: if docId == 'current'
          && request.resource.data.keys().hasOnly(['tables', 'updatedAt', 'revision'])
          && request.resource.data.revision is int
          && request.resource.data.revision >= 0
          && stringLen(request.resource.data.updatedAt, 40)
          && (
            canAccessLeagueData(leagueId)
            || (
              signedIn()
              && leagueDocAfter(leagueId).adminUid == request.auth.uid
            )
          );
        allow delete: if false;
      }

      match /matches/{matchId} {
        allow read: if canAccessLeagueData(leagueId);
        allow create, update: if canAccessLeagueData(leagueId)
          && request.resource.data.keys().hasOnly([
            'tables', 'updatedAt', 'revision', 'updatedByUid'
          ])
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.revision is int
          && request.resource.data.revision >= 0
          && stringLen(request.resource.data.updatedAt, 40)
          && stringLen(matchId, 80);
        allow delete: if canAccessLeagueData(leagueId);
      }
    }
  }
}
