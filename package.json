{
  "name": "dodgeball-score",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Dodgeball scorekeeper — static React app with Playwright tests",
  "scripts": {
    "predev": "node scripts/sync-sample-fixture.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-sample-fixture.mjs",
    "build": "tsc -b && vite build && node scripts/postbuild-spa-fallback.mjs",
    "preview": "vite preview",
    "build:gh-pages": "GITHUB_PAGES=true GITHUB_REPOSITORY=${GITHUB_REPOSITORY:-willbuck/dodgeball-score} npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:interop": "npm run test && playwright test tests/interop-fixtures.spec.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.0",
    "@mui/material": "^9.3.0",
    "@mui/x-charts": "^9.11.1",
    "firebase": "^12.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.10"
  }
}
